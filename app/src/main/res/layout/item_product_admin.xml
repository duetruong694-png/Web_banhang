<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <!-- ==================== ẢNH SẢN PHẨM ==================== -->
        <ImageView
            android:id="@+id/imgProduct"
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:layout_margin="6dp"
            android:scaleType="centerCrop"
            android:background="#F5F5F5"
            android:contentDescription="Hình ảnh sản phẩm" />

        <!-- ==================== THÔNG TIN ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="6dp">

            <!-- MÃ SẢN PHẨM -->
            <TextView
                android:id="@+id/tvProductCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mã SP: SP001"
                android:textColor="#888888"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- TÊN SẢN PHẨM -->
            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Bút chì"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- GIÁ -->
            <TextView
                android:id="@+id/tvProductPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="10.000 ₫"
                android:textColor="#EE4D2D"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <!-- TỒN KHO -->
            <TextView
                android:id="@+id/tvProductStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tồn kho: 20"
                android:textColor="#555555"
                android:textSize="10sp"
                android:maxLines="1" />

            <!-- NGÀY BÁN -->
            <TextView
                android:id="@+id/tvSaleDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ngày bán: 21/09/2026"
                android:textColor="#777777"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- TRẠNG THÁI -->
            <TextView
                android:id="@+id/tvProductStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Trạng thái: Đang bán"
                android:textColor="#2E7D32"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- MÔ TẢ -->
            <TextView
                android:id="@+id/tvProductDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Mô tả sản phẩm"
                android:textColor="#777777"
                android:textSize="9sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- ==================== NÚT SỬA / XÓA ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <!-- NÚT SỬA -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEdit"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="Sửa"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_edit_small"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null" />

                <!-- NÚT XÓA -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDelete"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="Xóa"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_delete_small"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>

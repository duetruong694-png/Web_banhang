<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- ================= HEADER SHOPEE ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:background="#EE4D2D">

        <!-- Logo + tên cửa hàng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAPP"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.08"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CỬA HÀNG ABC"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mua sắm tiện lợi mỗi ngày"
                    android:textSize="12sp"
                    android:textColor="#FFE8E0"/>
            </LinearLayout>

        </LinearLayout>


        <!-- ================= SEARCH ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="19sp"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Tìm kiếm sản phẩm..."
                android:textSize="14sp"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:singleLine="true"
                android:padding="0dp"/>

            <TextView
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="🔎"
                android:textSize="20sp"
                android:textColor="#EE4D2D"/>

        </LinearLayout>


        <!-- ================= ACCOUNT + CART ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Xin chào!"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Đăng nhập"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#EE4D2D"
                android:background="@drawable/bg_button_login"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Đăng xuất"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_logout"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnCart"
                android:layout_width="48dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:text="🛒"
                android:textSize="19sp"
                android:textColor="#EE4D2D"
                android:background="@drawable/bg_button_cart"
                android:padding="0dp"/>

        </LinearLayout>

    </LinearLayout>


    <!-- ================= BANNER ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="105dp"
        android:layout_margin="10dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="#FFF0EB">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 ƯU ĐÃI HÔM NAY"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#EE4D2D"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mua sắm tiết kiệm - Giá cực tốt"
            android:textSize="14sp"
            android:textColor="#555555"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="🚚 Giao hàng nhanh • 🛡️ Sản phẩm chất lượng"
            android:textSize="11sp"
            android:textColor="#777777"/>

    </LinearLayout>


    <!-- ================= TIÊU ĐỀ SẢN PHẨM ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:gravity="center_vertical"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SẢN PHẨM NỔI BẬT"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xem tất cả ›"
            android:textSize="12sp"
            android:textColor="#EE4D2D"/>

    </LinearLayout>


    <!-- ================= DANH SÁCH SẢN PHẨM ================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="6dp"
        android:clipToPadding="false"
        android:background="#F5F5F5"/>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7F9">

    <!-- ================= HEADER ================= -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:background="@drawable/bg_admin_header"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- LOGO -->
        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="D"
            android:textColor="#EE4D2D"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/bg_admin_logo" />

        <!-- TÊN APP -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="9dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAPP"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quản trị cửa hàng"
                android:textColor="#FFE9E1"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- ADMIN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="ADMIN"
            android:textColor="#EE4D2D"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/bg_admin_badge" />

        <!-- ĐĂNG XUẤT -->
        <Button
            android:id="@+id/btnDangXuat"
            android:layout_width="76dp"
            android:layout_height="34dp"
            android:layout_marginStart="7dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Đăng xuất"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_admin_logout_header" />

    </LinearLayout>


    <!-- ================= NỘI DUNG ================= -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp">

            <!-- TIÊU ĐỀ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tổng quan"
                android:textColor="#202124"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Quản lý cửa hàng"
                android:textColor="#888888"
                android:textSize="11sp" />


            <!-- ================= 3 CHỨC NĂNG ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- SẢN PHẨM -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp"
                    android:background="@drawable/bg_admin_menu_card">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="27dp"
                        android:gravity="center"
                        android:text="▦"
                        android:textColor="#EE4D2D"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnDanhSach"
                        android:layout_width="match_parent"
                        android:layout_height="31dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="Sản phẩm"
                        android:textAllCaps="false"
                        android:textColor="#333333"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@android:color/transparent" />

                </LinearLayout>


                <!-- THÊM SẢN PHẨM -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp"
                    android:background="@drawable/bg_admin_menu_card">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="27dp"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="#EE4D2D"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnThemSanPham"
                        android:layout_width="match_parent"
                        android:layout_height="31dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="Thêm SP"
                        android:textAllCaps="false"
                        android:textColor="#333333"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@android:color/transparent" />

                </LinearLayout>


                <!-- ĐƠN HÀNG -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp"
                    android:background="@drawable/bg_admin_menu_card">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="27dp"
                        android:gravity="center"
                        android:text="≡"
                        android:textColor="#EE4D2D"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnDonHang"
                        android:layout_width="match_parent"
                        android:layout_height="31dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="Đơn hàng"
                        android:textAllCaps="false"
                        android:textColor="#333333"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@android:color/transparent" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================= PHẦN SẢN PHẨM ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sản phẩm"
                        android:textColor="#202124"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Danh sách sản phẩm"
                        android:textColor="#888888"
                        android:textSize="10sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="27dp"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="QUẢN LÝ"
                    android:textColor="#EE4D2D"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_admin_small_badge" />

            </LinearLayout>


            <!-- ================= DANH SÁCH ================= -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="500dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardUseCompatPadding="true">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerProducts"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="3dp"
                    android:clipToPadding="false"
                    android:scrollbars="vertical" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7F9">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:background="#EE4D2D"
        android:elevation="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- LOGO -->
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="D"
            android:textColor="#EE4D2D"
            android:textSize="21sp"
            android:textStyle="bold"
            android:background="@drawable/bg_admin_logo"/>

        <!-- TITLE -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAPP"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quản trị cửa hàng"
                android:textColor="#FFE5DC"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- ADMIN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="29dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="ADMIN"
            android:textColor="#EE4D2D"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/bg_admin_badge"/>

        <!-- LOGOUT -->
        <Button
            android:id="@+id/btnDangXuat"
            android:layout_width="82dp"
            android:layout_height="36dp"
            android:layout_marginStart="7dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="Đăng xuất"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_admin_logout_header"/>

    </LinearLayout>


    <!-- MAIN CONTENT -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tổng quan"
            android:textColor="#202124"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Quản lý cửa hàng DAPP"
            android:textColor="#888888"
            android:textSize="12sp"/>


        <!-- MENU -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <!-- PRODUCT -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_admin_menu_card">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:gravity="center"
                    android:text="▦"
                    android:textColor="#EE4D2D"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnDanhSach"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="Sản phẩm"
                    android:textAllCaps="false"
                    android:textColor="#333333"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@android:color/transparent"/>
            </LinearLayout>


            <!-- ADD PRODUCT -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_admin_menu_card">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#EE4D2D"
                    android:textSize="28sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnThemSanPham"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="Thêm sản phẩm"
                    android:textAllCaps="false"
                    android:textColor="#333333"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@android:color/transparent"/>
            </LinearLayout>


            <!-- ORDERS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_admin_menu_card">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:gravity="center"
                    android:text="≡"
                    android:textColor="#EE4D2D"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnDonHang"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="Đơn hàng"
                    android:textAllCaps="false"
                    android:textColor="#333333"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@android:color/transparent"/>
            </LinearLayout>

        </LinearLayout>


        <!-- PRODUCT TITLE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sản phẩm"
                    android:textColor="#202124"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Danh sách sản phẩm"
                    android:textColor="#888888"
                    android:textSize="11sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="QUẢN LÝ"
                android:textColor="#EE4D2D"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_admin_small_badge"/>
        </LinearLayout>


        <!-- PRODUCT LIST -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerProducts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:clipToPadding="false"
                android:scrollbars="vertical"/>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>